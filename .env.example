# Steam Web API key (https://steamcommunity.com/dev/apikey)
# App details, reviews, and CCU work without this.
# With a key, Steam Charts rising titles are also added as candidates.
STEAM_API_KEY=

# Gemini API key (https://aistudio.google.com/apikey)
# Without this key, Japanese fallback summaries are used to still generate HTML.
GEMINI_API_KEY=

# Model name. gemini-2.5-flash returns 404 for many new keys; use 3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# Catalog cap. Existing titles are kept and new titles accumulate up to this.
MAX_GAMES=100

# Max brand-new titles added per run (Gemini is called only for these).
MAX_NEW_GAMES=3
MAX_GEMINI_PER_RUN=3

# New-title quality gates (skip unreleased / empty / adult / AAA).
MIN_REVIEWS_NEW=15
MAX_REVIEWS_NEW=80000
MIN_REVIEWS_EN_ONLY=80
MAX_NEW_INSPECT=80

# Public site URL for OGP/canonical (no trailing slash)
# Example: https://yourname.github.io/IndieGem
SITE_BASE_URL=
